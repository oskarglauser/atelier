# Every variable the hosted server reads. Names only, never real values.
# Local: cp .env.example .env and fill in. Production: set in Coolify.
# Which are required depends on server/src/config.ts and NODE_ENV
# (see server/src/env.ts) — the server refuses to start without them.

# App. Atelier is project 06 in infra INFRA.md "Local ports":
# app 3006, Postgres 5406. APP_URL and BETTER_AUTH_URL are
# http://localhost:3006 locally, https://atelier.glauser.com in production.
NODE_ENV=
PORT=
APP_URL=

# Database. POSTGRES_PORT is only for local docker compose (not set in
# Coolify). Locally DATABASE_URL is postgres://app:app@localhost:5406/app
POSTGRES_PORT=
DATABASE_URL=

# Auth. BETTER_AUTH_SECRET is at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP). Production: relay.hostup.se, port 587, no user/password.
# Locally leave SMTP_HOST empty and sign-in codes print in the terminal.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Files. Images in cloud documents go to R2 rather than into the document.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Analytics: Appscope (https://appscope.glauser.com). Both optional.
APPSCOPE_KEY=
APPSCOPE_SECRET_KEY=
